+import { useTranslation } from "react-i18next";
+import { Button } from "~/components/ui/button";
+
+export type OrderCountProps = { count: number; refreshing?: boolean; onRefresh: () => void };
+
+// Controlled: the container owns the data and passes the count in.
+export function OrderCount({ count, refreshing, onRefresh }: OrderCountProps) {
+  const { t } = useTranslation();
+  return (
+    <div className="flex items-center gap-2 py-2">
+      <span className="text-sm">{t("orderCount.label", { count })}</span>
+      <Button variant="outline" disabled={refreshing} onClick={onRefresh}>{t("orderCount.refresh")}</Button>
+    </div>
+  );
+}
