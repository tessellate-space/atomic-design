@@ -0,0 +1,16 @@
+import { useQuery, useQueryClient } from "@tanstack/react-query";
+import { OrderCount } from "~/components/molecules/order-count";
+import { fetchOrders } from "~/lib/api";
+import { ordersKeys } from "./query-keys";
+
+export function OrderCountContainer() {
+  const client = useQueryClient();
+  const orders = useQuery({ queryKey: ordersKeys.all, queryFn: fetchOrders });
+  return (
+    <OrderCount
+      count={orders.data?.length ?? 0}
+      refreshing={orders.isFetching}
+      onRefresh={() => void client.invalidateQueries({ queryKey: ordersKeys.all })}
+    />
+  );
+}
