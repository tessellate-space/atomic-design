+import type { Meta, StoryObj } from "@storybook/react-vite";
+import { FilterSelect } from "./filter-select";
+
+const options = [
+  { value: "open", label: "Open" },
+  { value: "shipped", label: "Shipped" },
+];
+
+const meta = {
+  title: "Molecules/FilterSelect",
+  component: FilterSelect,
+  args: { label: "Filter by status", options, value: "open", onChange: () => {} },
+  parameters: {
+    atomic: {
+      status: "experimental",
+      owner: "Web team",
+      design: "https://www.figma.com/design/seeded/filter-select",
+      flow: "Narrows a list to one value of a fixed set, as a dropdown; replaces FilterBar.",
+      combinesWith: ["OrderList"],
+    },
+  },
+} satisfies Meta<typeof FilterSelect>;
+export default meta;
+
+type Story = StoryObj<typeof meta>;
+
+export const Default: Story = {};
+export const Empty: Story = { args: { options: [], value: "" } };
+export const Disabled: Story = { args: { disabled: true } };
+export const LongestCopy: Story = { args: { options: [{ value: "open", label: "Offene Bestellungen in Bearbeitung" }, { value: "shipped", label: "Bereits versandte Bestellungen" }] } };
diff --git a/src/components/molecules/filter-select.tsx b/src/components/molecules/filter-select.tsx
new file mode 100644
index 0000000..97912ed
--- /dev/null
+++ b/src/components/molecules/filter-select.tsx
@@ -0,0 +1,19 @@
+export type FilterSelectProps = {
+  label: string;
+  options: Array<{ value: string; label: string }>;
+  value: string;
+  onChange: (value: string) => void;
+  disabled?: boolean;
+};
+
+// Controlled: the parent owns the selection.
+export function FilterSelect({ label, options, value, onChange, disabled }: FilterSelectProps) {
+  return (
+    <label className="flex flex-col gap-1 py-2">
+      <span className="text-sm">{label}</span>
+      <select className="rounded-control border border-line px-2 py-1" value={value} disabled={disabled} onChange={(e) => onChange(e.target.value)}>
+        {options.map((o) => <option key={o.value} value={o.value}>{o.label}</option>)}
+      </select>
+    </label>
+  );
+}
