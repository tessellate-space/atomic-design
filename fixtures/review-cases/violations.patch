+++ b/src/components/molecules/pager.tsx
@@ -0,0 +1,15 @@
+import { useTranslation } from "react-i18next";
+import { Button } from "~/components/ui/button";
+
+export type PagerProps = { page: number; pageCount: number; onPageChange: (page: number) => void; disabled?: boolean };
+
+export function Pager({ page, pageCount, onPageChange, disabled }: PagerProps) {
+  const { t } = useTranslation();
+  return (
+    <nav className="flex items-center gap-2 py-2" aria-label={t("pager.position", { page, count: pageCount })}>
+      <Button variant="outline" disabled={disabled || page <= 1} onClick={() => onPageChange(page - 1)}>{t("pager.prev")}</Button>
+      <span className="text-sm">{t("pager.position", { page, count: pageCount })}</span>
+      <Button variant="outline" disabled={disabled || page >= pageCount} onClick={() => onPageChange(page + 1)}>{t("pager.next")}</Button>
+    </nav>
+  );
+}
