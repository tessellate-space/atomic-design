+++ b/src/components/molecules/status-picker.tsx
@@ -0,0 +1,17 @@
+import { Button } from "~/components/ui/button";
+
+type Option = { value: string; label: string };
+export type StatusPickerProps = { label: string; options: Option[]; value: string | null; onChange: (value: string | null) => void };
+
+// Controlled: the parent owns the selection.
+export function StatusPicker({ label, options, value, onChange }: StatusPickerProps) {
+  return (
+    <div role="group" aria-label={label} className="flex flex-wrap gap-2 py-2">
+      {options.map((o) => (
+        <Button key={o.value} type="button" variant={o.value === value ? "default" : "outline"} aria-pressed={o.value === value} onClick={() => onChange(o.value === value ? null : o.value)}>
+          {o.label}
+        </Button>
+      ))}
+    </div>
+  );
+}
